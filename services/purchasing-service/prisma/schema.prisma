// Purchasing service's own database (suppliers, supplier item prices,
// purchase orders, GRNs). Owned exclusively by this service.
generator client {
  provider = "prisma-client-js"
  // See identity-service/prisma/schema.prisma for why this isn't the
  // default hoisted node_modules/@prisma/client location.
  output = "../src/generated/prisma"
  // The default native query engine loads a binary via code that isn't
  // bundler-safe (breaks with "__dirname is not defined" under Vercel's
  // Node.js Function bundler). The Neon driver adapter (see db/client.ts)
  // replaces it with Neon's WebSocket driver — no native engine to load.
  // multiSchema + @@schema(...) below replaces the old `?schema=purchasing`
  // connection-string convention, which the driver adapter doesn't honor
  // and Neon's pooled endpoint won't accept as a startup parameter either.
  // "client" = the Rust-free query compiler. The default "library" engine
  // ships a native .node binary whose loader resolves its own path via
  // `eval("__dirname")`, which is undefined once Vercel's Function bundler
  // converts this to ESM — that's the "__dirname is not defined" crash.
  // driverAdapters/queryCompiler/multiSchema are all stable as of 6.16, so
  // they no longer belong in previewFeatures.
  engineType = "client"
}

datasource db {
  provider = "postgresql"
  url      = env("PURCHASING_DATABASE_URL")
  schemas  = ["purchasing"]
}

model Supplier {
  id               String   @id @default(cuid())
  name             String
  contactName      String?
  contactEmail     String?
  contactPhone     String?
  paymentTerms     String?
  leadTimeDays     Int?
  deliverySchedule String?
  rating           Float?
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  itemPrices     SupplierItemPrice[]
  purchaseOrders PurchaseOrder[]

  @@schema("purchasing")
}

// PRD §3.2 — item-supplier price list with a preferred supplier per item.
// `isPreferred` is enforced as "at most one per itemId" at the application
// layer (see upsertSupplierItemPrice), not a DB constraint, since Postgres
// partial-unique-index support isn't modeled through Prisma's schema DSL.
model SupplierItemPrice {
  id          String   @id @default(cuid())
  supplierId  String
  itemId      String
  price       Float
  packSize    String?
  moq         Float?
  isPreferred Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@unique([supplierId, itemId])
  @@index([itemId])
  @@schema("purchasing")
}

// PRD §3.3 — Draft -> Pending Approval -> Sent -> Confirmed -> Partially
// Received -> Received -> Closed (or Rejected), with timestamped history.
model PurchaseOrder {
  id               String   @id @default(cuid())
  poNumber         String   @unique
  supplierId       String
  locationId       String
  status           String   @default("DRAFT")
  totalAmount      Float    @default(0)
  createdByUserId  String
  approvedByUserId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  supplier      Supplier             @relation(fields: [supplierId], references: [id])
  lines         PurchaseOrderLine[]
  statusHistory PurchaseOrderStatusEvent[]
  grns          Grn[]

  @@index([status])
  @@index([locationId])
  @@index([supplierId])
  @@schema("purchasing")
}

model PurchaseOrderLine {
  id               String @id @default(cuid())
  purchaseOrderId  String
  itemId           String
  quantityOrdered  Float
  unitPrice        Float
  quantityReceived Float  @default(0)

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  grnLines      GrnLine[]

  @@index([purchaseOrderId])
  @@schema("purchasing")
}

// Immutable append-only status trail backing `PurchaseOrder.statusHistory`
// in the API contract — modeled as a related table (rather than a JSON
// column) so it reads/writes like every other audit-log pattern in this
// platform and stays queryable.
model PurchaseOrderStatusEvent {
  id              String   @id @default(cuid())
  purchaseOrderId String
  status          String
  byUserId        String
  at              DateTime @default(now())

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  @@index([purchaseOrderId])
  @@schema("purchasing")
}

// PRD §3.4 — Goods Receipt Note: received quantities + per-line discrepancy
// vs. ordered quantity, captured at receiving time.
model Grn {
  id               String   @id @default(cuid())
  purchaseOrderId  String
  locationId       String
  storageAreaId    String?
  hasDiscrepancy   Boolean  @default(false)
  receivedByUserId String
  createdAt        DateTime @default(now())

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  lines         GrnLine[]

  @@index([purchaseOrderId])
  @@schema("purchasing")
}

model GrnLine {
  id               String @id @default(cuid())
  grnId            String
  itemId           String
  poLineId         String
  quantityOrdered  Float
  quantityReceived Float
  discrepancy      Float
  discrepancyType  String
  batchNumber      String?
  expiryDate       DateTime?

  grn    Grn               @relation(fields: [grnId], references: [id], onDelete: Cascade)
  poLine PurchaseOrderLine @relation(fields: [poLineId], references: [id])

  @@index([grnId])
  @@schema("purchasing")
}
