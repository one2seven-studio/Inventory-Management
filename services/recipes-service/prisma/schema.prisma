// Recipes service's own database (recipe/BOM definitions + versions and
// their ingredient lines). Owned exclusively by this service. Raw item
// master data and stock levels live in inventory-service and are only
// ever reached over HTTP, never joined in this schema.
generator client {
  provider = "prisma-client-js"
  // See identity-service/prisma/schema.prisma for why this isn't the
  // default hoisted node_modules/@prisma/client location: every service
  // generates its Prisma client into its own folder instead of the shared
  // hoisted node_modules/@prisma/client, otherwise the last `prisma
  // generate` run across services would silently overwrite every other
  // service's client.
  output = "../src/generated/prisma"
  // The default native query engine loads a binary via code that isn't
  // bundler-safe (breaks with "__dirname is not defined" under Vercel's
  // Node.js Function bundler). The Neon driver adapter (see db/client.ts)
  // replaces it with Neon's WebSocket driver — no native engine to load.
  // multiSchema + @@schema(...) below replaces the old `?schema=recipes`
  // connection-string convention, which the driver adapter doesn't honor
  // and Neon's pooled endpoint won't accept as a startup parameter either.
  // "client" = the Rust-free query compiler. The default "library" engine
  // ships a native .node binary whose loader resolves its own path via
  // `eval("__dirname")`, which is undefined once Vercel's Function bundler
  // converts this to ESM — that's the "__dirname is not defined" crash.
  // driverAdapters/queryCompiler/multiSchema are all stable as of 6.16, so
  // they no longer belong in previewFeatures.
  engineType = "client"
}

datasource db {
  provider = "postgresql"
  url      = env("RECIPES_DATABASE_URL")
  schemas  = ["recipes"]
}

// A recipe is versioned: editing ingredients never mutates a row in place,
// it inserts a new row and flips isActive. `recipeGroupId` is the stable
// identifier for "this recipe" across all its versions — it defaults to the
// row's own id on first creation (see createRecipe) and is copied forward
// on every subsequent version (see updateRecipe).
model Recipe {
  id            String   @id @default(cuid())
  recipeGroupId String
  name          String
  type          String // "MENU_ITEM" | "SUB_RECIPE"
  yieldQuantity Float
  yieldUnit     String
  sellingPrice  Float?
  version       Int      @default(1)
  effectiveFrom DateTime @default(now())
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())

  ingredients RecipeIngredient[]

  @@index([recipeGroupId])
  @@schema("recipes")
}

// An ingredient line references exactly one of a raw inventory-service item
// (ingredientItemId) or another recipe (ingredientRecipeId, for nested
// sub-recipes) — never both, enforced in application code since Prisma
// doesn't support cross-field XOR constraints.
model RecipeIngredient {
  id                 String  @id @default(cuid())
  recipeId           String
  ingredientItemId   String?
  ingredientRecipeId String?
  quantity           Float
  unit               String

  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@index([recipeId])
  @@schema("recipes")
}
