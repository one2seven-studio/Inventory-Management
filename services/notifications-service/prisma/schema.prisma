// Notifications service's own database (in-app notification center rows,
// plus the internal bookkeeping alert-rules detection uses to dedupe
// repeat LOW_STOCK/EXPIRING_SOON alerts). Owned exclusively by this service.
generator client {
  provider = "prisma-client-js"
  // See identity-service/prisma/schema.prisma for why this isn't the
  // default hoisted node_modules/@prisma/client location.
  output = "../src/generated/prisma"
  // The default native query engine loads a binary via code that isn't
  // bundler-safe (breaks with "__dirname is not defined" under Vercel's
  // Node.js Function bundler). The Neon driver adapter (see db/client.ts)
  // replaces it with Neon's WebSocket driver — no native engine to load.
  // multiSchema + @@schema(...) below replaces the old
  // `?schema=notifications` connection-string convention, which the driver
  // adapter doesn't honor and Neon's pooled endpoint won't accept as a
  // startup parameter either.
  // "client" = the Rust-free query compiler. The default "library" engine
  // ships a native .node binary whose loader resolves its own path via
  // `eval("__dirname")`, which is undefined once Vercel's Function bundler
  // converts this to ESM — that's the "__dirname is not defined" crash.
  // driverAdapters/queryCompiler/multiSchema are all stable as of 6.16, so
  // they no longer belong in previewFeatures.
  engineType = "client"
}

datasource db {
  provider = "postgresql"
  url      = env("NOTIFICATIONS_DATABASE_URL")
  schemas  = ["notifications"]
}

model Notification {
  id           String   @id @default(cuid())
  type         String
  title        String
  message      String
  targetUserId String?
  targetRoles  String[] @default([])
  locationId   String?
  // Internal-only correlation key (itemId for LOW_STOCK, batchId for
  // EXPIRING_SOON) used by alert-rules to dedupe repeat alerts within a
  // rolling window. Not part of the public Notification DTO.
  referenceId  String?
  isRead       Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@schema("notifications")
}
